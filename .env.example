# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Leave both empty to run in LOCAL MODE (data stays only in this browser, no cloud backup).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The public anon key (or the newer "publishable" key, sb_publishable_...). Safe for the browser:
# all data access is enforced by row-level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put the service-role / secret key in this app. It is not needed and must not reach the browser.
